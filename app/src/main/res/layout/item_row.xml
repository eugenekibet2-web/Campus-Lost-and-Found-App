<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_white"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Item Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"/>

        <TextView
            android:id="@+id/tvItemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOST"
            android:textStyle="bold"
            android:textColor="@color/card_white"
            android:background="@color/lost_red"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvItemCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category: Electronics"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvItemDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Description goes here"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvItemLocationDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Location: Library | Date: 18/11/2026"
        android:textSize="13sp"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvItemContact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Contact: 0712345678"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="8dp"/>

    <!-- Optional Challenge: Mark as Claimed/Returned -->
    <Button
        android:id="@+id/btnMarkClaimed"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="Mark as Claimed / Returned"
        android:textSize="12sp"
        android:backgroundTint="@color/primary"/>

</LinearLayout>
